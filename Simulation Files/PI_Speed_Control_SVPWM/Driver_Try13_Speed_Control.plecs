"wbGFuYW4gc29ucmFraSBkdXJ1bWxhci4KICogRGlzY1N0YXRlJ2xlcmUgeWFsbml6Y2EgVXBkYXRl"
"J3RlIGFrdGFyaWxpci4KICovCnN0YXRpYyBkb3VibGUgbmV4dF9zdGF0ZVs4XTsKCnN0YXRpYyBkb"
"3VibGUgbGltaXRfdmFsdWUoZG91YmxlIHgsIGRvdWJsZSBsbywgZG91YmxlIGhpKQp7CiAgICBpZi"
"AoeCA8IGxvKSByZXR1cm4gbG87CiAgICBpZiAoeCA+IGhpKSByZXR1cm4gaGk7CiAgICByZXR1cm4"
"geDsKfQ=="
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "int k;\n"
"\n"
"for (k = 0; k < 8; k++)\n"
"{\n"
"    DiscState(k) = 0.0;\n"
"    next_state[k] = 0.0;\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* ================= GIRISLER ================= */\n"
"\n"
"double ia      = InputSignal(0, 0);\n"
"double ib      = InputSignal(0, 1);\n"
"double omega_m = InputSignal(0, 2);\n"
"double theta_m = InputSignal(0, 3);\n"
"double vdc     = InputSignal(0, 4);\n"
"double rpm_ref = InputSignal(0, 5);\n"
"\n"
"double rpm, omega_e;\n"
"double angle_deg, theta_e, cs, sn;\n"
"double ialpha, ibeta, id, iq;\n"
"double iq_raw, id_raw, id_ref, iq_ref, iq_max, temp;\n"
"double err_speed, err_d, err_q, err_fw;\n"
"double vd, vq, vmag, vmax, scale;\n"
"double valpha, vbeta, vref, pwm_vmax;\n"
"double angle, sector_angle;\n"
"double t1, t2, t0;\n"
"double da, db, dc;\n"
"double fw_error_filtered, fw_raw;\n"
"double flux_speed;\n"
"\n"
"int k;\n"
"int counter;\n"
"int slow_tick;\n"
"int sector;\n"
"\n"
"/* Mevcut durumlari kopyala; kalici durum burada degismez */\n"
"for (k = 0; k < 8; k++)\n"
"{\n"
"    next_state[k] = DiscState(k);\n"
"}\n"
"\n"
"counter = (int)DiscState(ST_COUNTER);\n"
"slow_tick = (counter == 0);\n"
"\n"
"next_state[ST_COUNTER] =\n"
"    (counter + 1 >= SLOW_DIV) ? 0.0 : counter + 1.0;\n"
"\n"
"/* ================= HIZ VE ACI ================= */\n"
"\n"
"rpm = omega_m * 60.0 / (2.0 * PI_VALUE);\n"
"omega_e = POLE_PAIRS * omega_m;\n"
"\n"
"rpm_ref = limit_value(\n"
"    rpm_ref, -SPEED_REF_MAX, SPEED_REF_MAX\n"
");\n"
"\n"
"/* Once +180 mekanik derece, sonra kutup cifti carpimi */\n"
"angle_deg =\n"
"    (theta_m * 180.0 / PI_VALUE + 180.0) * POLE_PAIRS;\n"
"\n"
"angle_deg = fmod(angle_deg, 360.0);\n"
"\n"
"if (angle_deg < 0.0)\n"
"{\n"
"    angle_deg += 360.0;\n"
"}\n"
"\n"
"theta_e = angle_deg * PI_VALUE / 180.0;\n"
"\n"
"cs = cos(theta_e);\n"
"sn = sin(theta_e);\n"
"\n"
"/* ================= CLARKE / PARK ================= */\n"
"\n"
"/* Ia + Ib + Ic = 0 kabulune gore */\n"
"ialpha = ia;\n"
"ibeta  = (ia + 2.0 * ib) / sqrt(3.0);\n"
"\n"
"id =  ialpha * cs + ibeta * sn;\n"
"iq = -ialpha * sn + ibeta * cs;\n"
"\n"
"/* ================= HIZ PI: 1 kHz ================= */\n"
"\n"
"iq_raw = DiscState(ST_IQ_RAW);\n"
"\n"
"if (slow_tick)\n"
"{\n"
"    err_speed = rpm_ref - rpm;\n"
"\n"
"    /* Forward Euler: cikista mevcut integral kullanilir */\n"
"    iq_raw =\n"
"        KP_SPEED * err_speed + DiscState(ST_INT_SPEED);\n"
"\n"
"    next_state[ST_INT_SPEED] =\n"
"        DiscState(ST_INT_SPEED)\n"
"        + KI_SPEED * TS_SLOW * err_speed;\n"
"\n"
"    next_state[ST_IQ_RAW] = iq_raw;\n"
"}\n"
"\n"
"/* ================= FW GECIKMESI: 1 ms ================= */\n"
"\n"
"/*\n"
" * FW PI cikisi 1 kHz'de degisir.\n"
" * Bir onceki yavas ornegin cikisi = 1 ms gecikme.\n"
" * Baslangic cikisi Start'ta 0.\n"
" */\n"
"id_raw = DiscState(ST_FW_DELAY);\n"
"\n"
"if (slow_tick)\n"
"{\n"
"    id_raw = DiscState(ST_FW_RAW);\n"
"    next_state[ST_FW_DELAY] = id_raw;\n"
"}\n"
"\n"
"/* ================= C-SCRIPT1: AKIM LIMITI ================= */\n"
"\n"
"/* Gonderdigin kosullar aynen korunuyor */\n"
"id_ref = id_raw;\n"
"\n"
"if (id_ref > 0.0)\n"
"{\n"
"    id_ref = 0.0;\n"
"}\n"
"\n"
"if (id_ref < -I_MAX)\n"
"{\n"
"    id_ref = -I_MAX * 0.9;\n"
"}\n"
"\n"
"temp = I_MAX * I_MAX - id_ref * id_ref;\n"
"\n"
"if (temp < 0.0)\n"
"{\n"
"    temp = 0.0;\n"
"}\n"
"\n"
"iq_max = sqrt(temp);\n"
"iq_ref = limit_value(iq_raw, -iq_max, iq_max);\n"
"\n"
"/* ================= AKIM PI'LARI: 50 kHz ================= */\n"
"\n"
"err_d = id_ref - id;\n"
"err_q = iq_ref - iq;\n"
"\n"
"/* Forward Euler */\n"
"vd = KP_D * err_d + DiscState(ST_INT_D);\n"
"vq = KP_Q * err_q + DiscState(ST_INT_Q);\n"
"\n"
"next_state[ST_INT_D] =\n"
"    DiscState(ST_INT_D) + KI_D * TS * err_d;\n"
"\n"
"next_state[ST_INT_Q] =\n"
"    DiscState(ST_INT_Q) + KI_Q * TS * err_q;\n"
"\n"
"/* ================= DECOUPLING ================= */\n"
"\n"
"vd -= omega_e * LQ * iq;\n"
"\n"
"flux_speed = FLUX_USE_ELECTRICAL_SPEED\n"
"           ? omega_e : omega_m;\n"
"\n"
"vq += omega_e * LD * id + PHI_F * flux_speed;\n"
"\n"
"/* ================= C-SCRIPT4: DQ GERILIM LIMITI ================= */\n"
"\n"
"/* FW geri beslemesine limit ONCESI buyukluk gider */\n"
"vmag = sqrt(vd * vd + vq * vq);\n"
"\n"
"vmax = DQ_LIMIT_RATIO * fmax(vdc, 0.0) / sqrt(3.0);\n"
"\n"
"scale = 1.0;\n"
"\n"
"if (vmag > vmax && vmag > 0.0)\n"
"{\n"
"    scale = vmax / vmag;\n"
"}\n"
"\n"
"vd *= scale;\n"
"vq *= scale;\n"
"\n"
"/* ================= FW ERROR GATE + PI: 1 kHz ================= */\n"
"\n"
"if (slow_tick)\n"
"{\n"
"    err_fw = vmax - vmag;\n"
"\n"
"    /* C-Script2: olculen Id ile error gate */\n"
"    if ((err_fw < 0.0) && (id <= FW_ID_MIN))\n"
"    {\n"
"        fw_error_filtered = 0.0;\n"
"    }\n"
"    else if ((err_fw > 0.0) && (id >= FW_ID_MAX))\n"
"    {\n"
"        fw_error_filtered = 0.0;\n"
"    }\n"
"    else\n"
"    {\n"
"        fw_error_filtered = err_fw;\n"
"    }\n"
"\n"
"    /* Forward Euler; cikis limiti / anti-windup yok */\n"
"    fw_raw =\n"
"        KP_FW * fw_error_filtered + DiscState(ST_INT_FW);\n"
"\n"
"    next_state[ST_INT_FW] =\n"
"        DiscState(ST_INT_FW)\n"
"        + KI_FW * TS_SLOW * fw_error_filtered;\n"
"\n"
"    /* Bu cikis 1 ms sonra Id_raw olarak kullanilacak */\n"
"    next_state[ST_FW_RAW] = fw_raw;\n"
"}\n"
"\n"
"/* ================= INVERSE PARK ================= */\n"
"\n"
"valpha = vd * cs - vq * sn;\n"
"vbeta  = vd * sn + vq * cs;\n"
"\n"
"/* ================= SVPWM: 50 kHz ================= */\n"
"\n"
"da = 0.5;\n"
"db = 0.5;\n"
"dc = 0.5;\n"
"\n"
"/* Sifira bolunmeyi onle */\n"
"if (vdc > 1e-6)\n"
"{\n"
"    vref = sqrt(valpha * valpha + vbeta * vbeta);\n"
"    pwm_vmax = PWM_LIMIT_RATIO * vdc / sqrt(3.0);\n"
"\n"
"    if (vref > pwm_vmax && vref > 0.0)\n"
"    {\n"
"        scale = pwm_vmax / vref;\n"
"        valpha *= scale;\n"
"        vbeta  *= scale;\n"
"        vref = pwm_vmax;\n"
"    }\n"
"\n"
"    angle = atan2(vbeta, valpha);\n"
"\n"
"    if (angle < 0.0)\n"
"    {\n"
"        angle += 2.0 * PI_VALUE;\n"
"    }\n"
"\n"
"    sector = (int)floor(angle / (PI_VALUE / 3.0)) + 1;\n"
"\n"
"    if (sector > 6)\n"
"    {\n"
"        sector = 6;\n"
"    }\n"
"\n"
"    sector_angle = angle - (sector - 1) * PI_VALUE / 3.0;\n"
"\n"
"    t1 = TS * sqrt(3.0) * vref / vdc\n"
"       * sin(PI_VALUE / 3.0 - sector_angle);\n"
"\n"
"    t2 = TS * sqrt(3.0) * vref / vdc\n"
"       * sin(sector_angle);\n"
"\n"
"    t0 = TS - t1 - t2;\n"
"\n"
"    if (t0 < 0.0)\n"
"    {\n"
"        t0 = 0.0;\n"
"    }\n"
"\n"
"    switch (sector)\n"
"    {\n"
"        case 1:\n"
"            da = (t1 + t2 + t0 / 2.0) / TS;\n"
"            db = (t2 + t0 / 2.0) / TS;\n"
"            dc = (t0 / 2.0) / TS;\n"
"            break;\n"
"\n"
"        case 2:\n"
"            da = (t1 + t0 / 2.0) / TS;\n"
"            db = (t1 + t2 + t0 / 2.0) / TS;\n"
"            dc = (t0 / 2.0) / TS;\n"
"            break;\n"
"\n"
"        case 3:\n"
"            da = (t0 / 2.0) / TS;\n"
"            db = (t1 + t2 + t0 / 2.0) / TS;\n"
"            dc = (t2 + t0 / 2.0) / TS;\n"
"            break;\n"
"\n"
"        case 4:\n"
"            da = (t0 / 2.0) / TS;\n"
"            db = (t1 + t0 / 2.0) / TS;\n"
"            dc = (t1 + t2 + t0 / 2.0) / TS;\n"
"            break;\n"
"\n"
"        case 5:\n"
"            da = (t2 + t0 / 2.0) / TS;\n"
"            db = (t0 / 2.0) / TS;\n"
"            dc = (t1 + t2 + t0 / 2.0) / TS;\n"
"            break;\n"
"\n"
"        case 6:\n"
"            da = (t1 + t2 + t0 / 2.0) / TS;\n"
"            db = (t0 / 2.0) / TS;\n"
"            dc = (t1 + t0 / 2.0) / TS;\n"
"            break;\n"
"    }\n"
"}\n"
"\n"
"/* ================= CIKISLAR ================= */\n"
"\n"
"OutputSignal(0, 0) = limit_value(da, 0.0, 1.0);\n"
"OutputSignal(0, 1) = limit_value(db, 0.0, 1.0);\n"
"OutputSignal(0, 2) = limit_value(dc, 0.0, 1.0);\n"
"\n"
"OutputSignal(0, 3) = iq;\n"
"OutputSignal(0, 4) = id;\n"
"OutputSignal(0, 5) = rpm;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "int k;\n"
"\n"
"for (k = 0; k < 8; k++)\n"
"{\n"
"    DiscState(k) = next_state[k];\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
