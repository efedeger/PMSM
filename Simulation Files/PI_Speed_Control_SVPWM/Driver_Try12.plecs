    Component {
      Type          CScript
      Name          "C-Script4"
      Show          on
      Position      [995, 575]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[584 352 422 314]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
