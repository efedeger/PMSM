    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [1475, 570]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[825 374 422 314]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "3"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "3"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "20e-6"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"double Ts = 20e-6;\n"
"\n"
"double angle;\n"
"double Vref;\n"
"double Vref_raw;\n"
"double Vmax;\n"
"double scale;\n"
"\n"
"double Valpha1;\n"
"double Vbeta1;\n"
"\n"
"double sector;\n"
"double y;\n"
"\n"
"double T1;\n"
"double T2;\n"
"double T0;\n"
"\n"
"double Da;\n"
"double Db;\n"
"double Dc;"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "Da=0;\n"
"Db=0;\n"
"Dc=0;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Inputs */\n"
"double Valpha = InputSignal(0, 0);\n"
"double Vbeta  = InputSignal(0, 1);\n"
"double Vdc    = InputSignal(0, 2);\n"
"\n"
"/* Constants */\n"
"double PI = 3.141592653589793;\n"
"\n"
"/* -------------------------------------------------\n"
"   Voltage vector magnitude and SVPWM voltage limit\n"
"   ------------------------------------------------- */\n"
"\n"
"Vref_raw = sqrt(Valpha * Valpha + Vbeta * Vbeta);\n"
"\n"
"/* Linear SVPWM limit */\n"
"Vmax = 0.95 * Vdc / sqrt(3.0);\n"
"\n"
"/* Default: no scaling */\n"
"Valpha1 = Valpha;\n"
"Vbeta1  = Vbeta;\n"
"Vref    = Vref_raw;\n"
"\n"
"/* Limit voltage vector magnitude */\n"
"if (Vref_raw > Vmax && Vref_raw > 0.0)\n"
"{\n"
"    scale = Vmax / Vref_raw;\n"
"\n"
"    Valpha1 = Valpha * scale;\n"
"    Vbeta1  = Vbeta * scale;\n"
"\n"
"    Vref = Vmax;\n"
"}\n"
"\n"
"/* -------------------------------------------------\n"
"   Vector angle\n"
"   ------------------------------------------------- */\n"
"\n"
"angle = atan2(Vbeta1, Valpha1) * 180.0 / PI;\n"
"\n"
"if (angle < 0.0)\n"
"{\n"
"    angle += 360.0;\n"
"}\n"
"\n"
"if (angle >= 360.0)\n"
"{\n"
"    angle -= 360.0;\n"
"}\n"
"\n"
"/* -------------------------------------------------\n"
"   Sector determination\n"
"   ------------------------------------------------- */\n"
"\n"
"sector = floor(angle / 60.0) + 1.0;\n"
"\n"
"if (sector > 6.0)\n"
"{\n"
"    sector = 6.0;\n"
"}\n"
"\n"
"y = angle - (sector - 1.0) * 60.0;\n"
"\n"
"/* -------------------------------------------------\n"
"   Switching times\n"
"   ------------------------------------------------- */\n"
"\n"
"T1 = (Ts * sqrt(3.0) * Vref / Vdc)\n"
"     * sin((60.0 - y) * PI / 180.0);\n"
"\n"
"T2 = (Ts * sqrt(3.0) * Vref / Vdc)\n"
"     * sin(y * PI / 180.0);\n"
"\n"
"T0 = Ts - T1 - T2;\n"
"\n"
"if (T0 < 0.0)\n"
"{\n"
"    T0 = 0.0;\n"
"}\n"
"\n"
"/* -------------------------------------------------\n"
"   Duty cycle generation\n"
"   ------------------------------------------------- */\n"
"\n"
"if (sector == 1.0)\n"
"{\n"
"    Da = (T1 + T2 + T0 / 2.0) / Ts;\n"
"    Db = (T2 + T0 / 2.0) / Ts;\n"
"    Dc = (T0 / 2.0) / Ts;\n"
"}\n"
"else if (sector == 2.0)\n"
"{\n"
"    Da = (T1 + T0 / 2.0) / Ts;\n"
"    Db = (T1 + T2 + T0 / 2.0) / Ts;\n"
"    Dc = (T0 / 2.0) / Ts;\n"
"}\n"
"else if (sector == 3.0)\n"
"{\n"
"    Da = (T0 / 2.0) / Ts;\n"
"    Db = (T1 + T2 + T0 / 2.0) / Ts;\n"
"    Dc = (T2 + T0 / 2.0) / Ts;\n"
"}\n"
"else if (sector == 4.0)\n"
"{\n"
"    Da = (T0 / 2.0) / Ts;\n"
"    Db = (T1 + T0 / 2.0) / Ts;\n"
"    Dc = (T1 + T2 + T0 / 2.0) / Ts;\n"
"}\n"
"else if (sector == 5.0)\n"
"{\n"
"    Da = (T2 + T0 / 2.0) / Ts;\n"
"    Db = (T0 / 2.0) / Ts;\n"
"    Dc = (T1 + T2 + T0 / 2.0) / Ts;\n"
"}\n"
"else if (sector == 6.0)\n"
"{\n"
"    Da = (T1 + T2 + T0 / 2.0) / Ts;\n"
"    Db = (T0 / 2.0) / Ts;\n"
"    Dc = (T1 + T0 / 2.0) / Ts;\n"
"}\n"
"else\n"
"{\n"
"    Da = 0.5;\n"
"    Db = 0.5;\n"
"    Dc = 0.5;\n"
"}\n"
"\n"
"/* -------------------------------------------------\n"
"   Final duty safety clamp\n"
"   ------------------------------------------------- */\n"
"\n"
"if (Da > 1.0) Da = 1.0;\n"
"if (Da < 0.0) Da = 0.0;\n"
"\n"
"if (Db > 1.0) Db = 1.0;\n"
"if (Db < 0.0) Db = 0.0;\n"
"\n"
"if (Dc > 1.0) Dc = 1.0;\n"
"if (Dc < 0.0) Dc = 0.0;\n"
"\n"
"/* Outputs */\n"
"OutputSignal(0, 0) = Da;\n"
"OutputSignal(0, 1) = Db;\n"
"OutputSignal(0, 2) = Dc;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
