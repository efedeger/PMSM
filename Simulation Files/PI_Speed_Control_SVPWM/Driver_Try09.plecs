      Parameter {
        Variable      "OutputFcn"
        Value         "double angle = InputSignal(0, 0);\n"
"\n"
"double wrapped = fmod(angle, 360.0);\n"
"\n"
"if (wrapped < 0.0)\n"
"{\n"
"    wrapped += 360.0;\n"
"}\n"
"\n"
"OutputSignal(0, 0) = wrapped;"
        Show          off
      }
