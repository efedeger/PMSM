      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define Id_ref_raw Input(0)\n"
"#define Iq_ref Input(1)\n"
"#define Imax Input(2)\n"
"#define Iq_ref_limited Output(0)\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double id_ref = InputSignal(0, 0);\n"
"double iq_ref = InputSignal(0, 1);\n"
"double imax   = InputSignal(0, 2);\n"
"\n"
"double iq_max;\n"
"double temp = imax * imax - id_ref * id_ref;\n"
"\n"
"if (temp > 0.0)\n"
"{\n"
"    iq_max = sqrt(temp);\n"
"}\n"
"else\n"
"{\n"
"    iq_max = 0.0;\n"
"}\n"
"\n"
"if (iq_ref > iq_max)\n"
"{\n"
"    iq_ref = iq_max;\n"
"}\n"
"else if (iq_ref < -iq_max)\n"
"{\n"
"    iq_ref = -iq_max;\n"
"}\n"
"\n"
"OutputSignal(0, 0) = iq_ref;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
