    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [1395, 745]
      Direction     up
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "DialogGeometry"
        Value         "[825 374 422 314]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "3"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "20e-6"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define Valpha Input(0)\n"
"#define Vbeta Input(1)\n"
"#define Da Output(0)\n"
"#define Db Output(1)\n"
"#define Dc Output(2)\n"
"double y=0;\n"
"double Ts=20e-6;\n"
"double T0=0;\n"
"double T1=0;\n"
"double T2=0;\n"
"double Vdc=24;\n"
"int sector=0;\n"
"double angle=0;\n"
"double Vref=0;\n"
"double PI=3.14159265358979323846;\n"
"double scale=0;\n"
"double Valpha1=0;\n"
"double Vbeta1=0;"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "Da=0;\n"
"Db=0;\n"
"Dc=0;"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "angle = atan2(Vbeta ,Valpha)*180/PI;\n"
"Vref = sqrt(Valpha*Valpha + Vbeta*Vbeta);\n"
"if (Vref > 13.86)\n"
"{\n"
"    scale = 13.86 / Vref;\n"
"\n"
"    Valpha1 = Valpha * scale;\n"
"    Vbeta1  = Vbeta  * scale;\n"
"\n"
"    Vref = 13.86;\n"
"}\n"
"\n"
"if (angle < 0.0)\n"
"    angle += 360.0;\n"
"\n"
"if (angle >= 360.0)\n"
"    angle -= 360.0;\n"
"\n"
"sector = floor(angle / 60) + 1;\n"
"y = angle - (sector-1)*60;\n"
"\n"
"T1=(Ts*sqrt(3)*Vref/Vdc)*sin((60 - y)*PI/180);\n"
"T2=(Ts*sqrt(3)*Vref/Vdc)*sin(y*PI/180);\n"
"T0=Ts-T1-T2;\n"
"if (T0 < 0.0)\n"
"    T0 = 0.0;\n"
"\n"
"if(sector==1){\n"
"\t Da = (T1 + T2 + T0/2)/Ts;\n"
"    Db = (T2 + T0/2)/Ts;\n"
"    Dc = (T0/2)/Ts;\n"
"}\n"
"else if (sector == 2)\n"
"{\n"
"    Da = (T1 + T0/2.0) / Ts;\n"
"    Db = (T1 + T2 + T0/2.0) / Ts;\n"
"    Dc = (T0/2.0) / Ts;\n"
"}\n"
"else if (sector == 3)\n"
"{\n"
"    Da = (T0/2.0) / Ts;\n"
"    Db = (T1 + T2 + T0/2.0) / Ts;\n"
"    Dc = (T2 + T0/2.0) / Ts;\n"
"}\n"
"else if (sector == 4)\n"
"{\n"
"    Da = (T0/2.0) / Ts;\n"
"    Db = (T1 + T0/2.0) / Ts;\n"
"    Dc = (T1 + T2 + T0/2.0) / Ts;\n"
"}\n"
"else if (sector == 5)\n"
"{\n"
"    Da = (T2 + T0/2.0) / Ts;\n"
"    Db = (T0/2.0) / Ts;\n"
"    Dc = (T1 + T2 + T0/2.0) / Ts;\n"
"}\n"
"else if (sector == 6)\n"
"{\n"
"    Da = (T1 + T2 + T0/2.0) / Ts;\n"
"    Db = (T0/2.0) / Ts;\n"
"    Dc = (T1 + T0/2.0) / Ts;\n"
"}\n"
"else\n"
"{\n"
"    Da = 0.5;\n"
"    Db = 0.5;\n"
"    Dc = 0.5;\n"
"}\n"
"Output(0) = Da;\n"
"Output(1) = Db;\n"
"Output(2) = Dc;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
